# Copy to apps/web/.env.local (gitignored) and fill in from the providers (SOP-07).
# Never paste a real value into chat, an issue, or a commit.

# Postgres connection string for the Supabase `dev` project, with `?sslmode=require` appended
# (the app forces TLS itself; the suffix makes drizzle-kit do the same).
# Locally either string works; on Vercel use the pooled "Transaction" string (port 6543).
DATABASE_URL=

# Set automatically by Vercel; shown in /api/health as "commit". Leave unset locally.
# VERCEL_GIT_COMMIT_SHA=

# --- added in M2 (auth, profiles) ---
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ALLOWED_EMAIL_DOMAINS=maryvillecollege.edu,my.maryvillecollege.edu

# --- added in M3/M4 (trading, lifecycle, stipends) ---
# CRON_SECRET=
# TRADING_PAUSED=false
# STIPEND_POINTS_WEEKLY=1000
# SIGNUP_BONUS_POINTS=10000
# BALANCE_CAP_POINTS=50000
