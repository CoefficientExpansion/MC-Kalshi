# Copy to apps/web/.env.local (gitignored) and fill in from the providers (SOP-07).
# Never paste a real value into chat, an issue, or a commit.

# Postgres connection string for the Supabase `dev` project, with `?sslmode=require` appended
# (the app forces TLS itself; the suffix makes drizzle-kit do the same).
# Locally either string works; on Vercel use the pooled "Transaction" string (port 6543).
# `npm run db:migrate` applies the committed migrations and `npm run db:seed` adds the sample
# categories and markets (safe to re-run) to whichever database this points at.
DATABASE_URL=
# Optional, recommended in production: the database provider's CA certificate as PEM text (for
# Supabase, download it from Project Settings -> Database -> SSL Configuration). When set, the
# app verifies the server certificate and host name (like sslmode=verify-full); when unset it
# only encrypts. Paste it on one line with literal \n between lines if your host's editor is
# single-line (Vercel). Never commit a real value.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Owner (`postgres`) string for db:migrate/db:studio once DATABASE_URL logs in as mc_app (ADR-0006); unset, drizzle-kit uses DATABASE_URL.
# MIGRATION_DATABASE_URL=

# Set automatically by Vercel; shown in /api/health as "commit". Leave unset locally.
# VERCEL_GIT_COMMIT_SHA=

# --- added in M2 (auth, profiles; docs/specs/m2b-auth.md) ---
# Sign-in works only when the URL, a key and DATABASE_URL are all set; otherwise /sign-in shows a
# "not set up" notice and the rest of the app runs normally.
# Supabase project URL and browser-safe key (Project Settings -> API). Use the `dev` project locally.
# The key is the publishable key (sb_publishable_...) or the legacy anon key; either name works and
# the publishable one wins if both are set. Tables are RLS deny-all, so this key reads nothing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Not used by sign-in yet; reserved for admin auth operations (M4).
# SUPABASE_SERVICE_ROLE_KEY=
# Absolute URL of this deployment (http://localhost:3000 locally). Not needed by the code flow.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Who may sign in: comma-separated email domains, exact match. Defaults to the two below.
# The database hook `hook_before_user_created` has the same two domains written into its SQL,
# so changing them here means a new migration too.
# ALLOWED_EMAIL_DOMAINS=maryvillecollege.edu,my.maryvillecollege.edu
# Points credited once to a new member at first sign-in (whole number, default 10000).
# SIGNUP_BONUS_POINTS=10000

# --- added in M3/M4 (trading, lifecycle, stipends) ---
# CRON_SECRET=
# TRADING_PAUSED=false
# STIPEND_POINTS_WEEKLY=1000
# BALANCE_CAP_POINTS=50000
